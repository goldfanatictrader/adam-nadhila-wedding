---
import Site from '../layouts/Site.astro';
import AuthForm from '../components/AuthForm';
import { env } from 'cloudflare:workers';
import type { Env } from '../lib/types';
const sitekey = (env as unknown as Env).PUBLIC_TURNSTILE_SITE_KEY || '';
---

<Site title="Atur ulang password — CELEYO" noindex>
  <main id="main-content" tabindex="-1" class="auth-shell">
    <AuthForm mode="reset" sitekey={sitekey} client:load />
  </main>
</Site>
