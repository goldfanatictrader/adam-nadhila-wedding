---
import Wedding from '../../../components/Wedding.astro';
import { env } from 'cloudflare:workers';
import type { Env } from '../../../lib/types';
import { actor, accessEvent } from '../../../lib/server/auth';
import { contentSchema } from '../../../lib/content';
import { all } from '../../../lib/server/db';
const bindings = env as unknown as Env;
let event;
try {
  const user = await actor(bindings, Astro.request);
  event = await accessEvent(bindings, user, Astro.params.id!);
} catch {
  return Astro.redirect('/login');
}
const content = contentSchema.parse(JSON.parse(event.draft));
const focal = Object.fromEntries(
  (
    await all<{ id: string; focal_x: number; focal_y: number }>(
      bindings.DB,
      'SELECT id,focal_x,focal_y FROM media_assets WHERE tenant_id=? AND event_id=?',
      event.tenant_id,
      event.id,
    )
  ).map((m) => [m.id, `${m.focal_x}% ${m.focal_y}%`]),
);
---

<Wedding
  content={content}
  template={event.template_id}
  slug={event.slug}
  origin={bindings.PUBLIC_SITE_URL}
  preview
  focal={focal}
  hideBrand={event.plan !== 'starter' && content.hideBrand}
/>
