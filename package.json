{
  "name": "celeyo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check",
    "test": "vitest run",
    "verify": "npm run check && npm run lint && npm test && npm run build",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "node scripts/seed.mjs",
    "deploy": "node scripts/deploy.mjs",
    "cf:types": "wrangler types",
    "setup:local": "node scripts/local-setup.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts astro.config.mjs tsconfig.json",
    "lint": "prettier --check src tests scripts astro.config.mjs tsconfig.json",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs",
    "brand:build": "node scripts/build-brand-assets.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/react": "^7.0.0",
    "astro": "^7.3.5",
    "better-auth": "^1.7.6",
    "image-size": "^2.0.4",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260929.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fontkitten": "^1.0.3",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2",
    "wrangler": "^4.143.0"
  },
  "overrides": {
    "undici@^7": "^7.29.1"
  }
}
